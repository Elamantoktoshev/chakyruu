// Chakyruu.kg — data model.
// Multi-tenant ready: Organization (тойкана / агентство) owns users and invitations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgPlan {
  FREE
  PRO
  BUSINESS
}

enum UserRole {
  OWNER
  ORG_ADMIN
  ADMIN
}

enum TemplateType {
  WEDDING
  KYZ_UZATUU
  BESHIK
  SUNNOT
  MAARAKE
}

enum Language {
  KY
  RU
}

enum InvitationStatus {
  DRAFT
  PAID
  PUBLISHED
}

enum GuestStatus {
  INVITED
  ATTENDING
  DECLINED
}

/// INVITED — added by the host (personal link); SELF — answered through the shared link.
enum GuestSource {
  INVITED
  SELF
}

enum PaymentProvider {
  MBANK
  ODENGI
  ELSOM
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  phone       String?
  plan        OrgPlan      @default(FREE)
  users       User[]
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id             String        @id @default(cuid())
  phone          String        @unique
  name           String?
  role           UserRole      @default(OWNER)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?
  invitations    Invitation[]
  sessions       Session[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

/// One-time SMS login code. Only an HMAC of the code is stored.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// Login session. The cookie holds a random token; only its sha256 is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Template {
  id          String       @id @default(cuid())
  name        String
  type        TemplateType
  previewUrl  String?
  config      Json         @default("{}")
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Invitation {
  id             String           @id @default(cuid())
  slug           String           @unique
  template       Template         @relation(fields: [templateId], references: [id])
  templateId     String
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?
  eventType      TemplateType     @default(WEDDING)
  /// Drafts start empty; publishing requires hostNames, eventDate and venueName.
  hostNames      String           @default("")
  eventDate      DateTime?
  venueName      String           @default("")
  venueAddress   String?
  venueMapUrl    String?
  photoUrl       String?
  /// Storage key of the uploaded photo (to delete it when replaced).
  photoKey       String?
  /// One of MUSIC_TRACKS in @chakyruu/shared.
  musicTrackId   String?
  message        String?
  language       Language         @default(KY)
  adultsOnly     Boolean          @default(false)
  status         InvitationStatus @default(DRAFT)
  publishedAt    DateTime?
  guests         Guest[]
  tilekter       Tilek[]
  payments       Payment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([ownerId])
  @@index([organizationId])
  @@index([templateId])
}

model Guest {
  id           String      @id @default(cuid())
  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  name         String
  phone        String?
  /// Secret for the personal link /:slug?g=<token>.
  token        String      @unique
  status       GuestStatus @default(INVITED)
  /// People coming including the guest (meaningful when ATTENDING).
  guestsCount  Int         @default(1)
  source       GuestSource @default(INVITED)
  respondedAt  DateTime?
  tilekter     Tilek[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([invitationId, status])
  @@index([invitationId, createdAt])
}

model Payment {
  id           String          @id @default(cuid())
  invitation   Invitation      @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  /// Amount in tyiyn (1 som = 100 tyiyn) to avoid floating point errors.
  amount       Int
  provider     PaymentProvider
  status       PaymentStatus   @default(PENDING)
  externalId   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([invitationId])
}

/// Wish (тилек) left by a guest on the invitation page.
model Tilek {
  id           String      @id @default(cuid())
  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  /// Set when written through a personal link.
  guest        Guest?      @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestId      String?
  authorName   String
  text         String
  /// Hidden by the owner: not shown publicly.
  hidden       Boolean     @default(false)
  likesCount   Int         @default(0)
  likes        TilekLike[]
  createdAt    DateTime    @default(now())

  @@index([invitationId, hidden, createdAt])
}

/// One like per browser (anonymous client id kept in localStorage).
model TilekLike {
  tilek     Tilek    @relation(fields: [tilekId], references: [id], onDelete: Cascade)
  tilekId   String
  clientId  String
  createdAt DateTime @default(now())

  @@id([tilekId, clientId])
}

/// Partnership request from a тойкана / agency on the landing page.
model PartnerLead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  venueName String
  city      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
