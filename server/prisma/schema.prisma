// Chakyruu.kg — data model.
// Multi-tenant ready: Organization (тойкана / агентство) owns users and invitations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgPlan {
  FREE
  PRO
  BUSINESS
}

enum OpeningAnimation {
  BOZ_UY
  ENVELOPE
  CURTAINS
  TUNDUK
  /// The illustrated template's own layered opening (manifest.opening).
  TEMPLATE
  NONE
}

enum OrgType {
  VENUE
  TAMADA
  AGENCY
}

/// Whether a partner is shown in the public catalogue / builder pickers (moderated by ADMIN).
enum CatalogStatus {
  HIDDEN
  PUBLISHED
}

enum PartnerLanguage {
  KY
  RU
  UZ
}

enum CreditReason {
  PURCHASE
  GIFT_ISSUED
  GIFT_REFUND
  ADMIN_GRANT
}

enum UserRole {
  OWNER
  ORG_ADMIN
  ADMIN
}

enum TemplateType {
  WEDDING
  KYZ_UZATUU
  BESHIK
  SUNNOT
  MAARAKE
  /// Кече: birthdays, corporate parties, premieres.
  KECHE
  /// Башка: any other toi.
  OTHER
}

/// Catalog ribbon on a template card.
enum TemplateBadge {
  HIT
  NEW
}

enum Language {
  KY
  RU
}

enum InvitationStatus {
  DRAFT
  PAID
  PUBLISHED
}

enum GuestStatus {
  INVITED
  ATTENDING
  DECLINED
}

/// INVITED — added by the host (personal link); SELF — answered through the shared link.
enum GuestSource {
  INVITED
  SELF
}

enum PaymentProvider {
  MBANK
  ODENGI
  ELSOM
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Organization {
  id                String              @id @default(cuid())
  type              OrgType             @default(VENUE)
  name              String
  slug              String              @unique
  phone             String?
  whatsapp          String?
  instagram         String?
  city              String?
  logoUrl           String?
  logoKey           String?
  /// VENUE only.
  address           String?
  mapUrl            String?
  plan              OrgPlan             @default(FREE)
  /// Prepaid invitations the partner can gift to clients.
  invitationCredits Int                 @default(0)
  catalogStatus     CatalogStatus       @default(HIDDEN)
  users             User[]
  invitations       Invitation[]
  venueInvitations  Invitation[]        @relation("VenueInvitations")
  tamadaInvitations Invitation[]        @relation("TamadaInvitations")
  halls             Hall[]
  tamadaProfile     TamadaProfile?
  busyDates         TamadaBusyDate[]
  creditLedger      CreditTransaction[]
  giftCodes         GiftCode[]
  tamadaClicks      TamadaClick[]
  payments          Payment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([type, catalogStatus, city])
}

model Hall {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  capacity       Int
  invitations    Invitation[]
  giftCodes      GiftCode[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model TamadaProfile {
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String            @id
  displayName    String
  photoUrl       String?
  photoKey       String?
  bio            String?
  languages      PartnerLanguage[]
  priceFromSom   Int?
  /// Instagram / YouTube links (validated in @chakyruu/shared).
  videoUrls      String[]
  updatedAt      DateTime          @updatedAt
}

/// Dates a tamada marked as taken by hand (bookings outside Chakyruu).
model TamadaBusyDate {
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  date           DateTime     @db.Date

  @@id([organizationId, date])
}

/// Ledger of partner credits; Organization.invitationCredits is the running balance.
model CreditTransaction {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  amount         Int
  reason         CreditReason
  giftCodeId     String?
  paymentId      String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// One free published invitation a partner gives to a client (1 credit reserved on issue).
model GiftCode {
  id             String       @id @default(cuid())
  code           String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  clientPhone    String
  eventDate      DateTime     @db.Date
  hall           Hall?        @relation(fields: [hallId], references: [id], onDelete: SetNull)
  hallId         String?
  expiresAt      DateTime
  usedAt         DateTime?
  cancelledAt    DateTime?
  invitation     Invitation?  @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  invitationId   String?      @unique
  createdAt      DateTime     @default(now())

  @@index([clientPhone])
  @@index([organizationId, createdAt])
}

/// "Тамадага жазуу" taps on invitation pages.
model TamadaClick {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  invitationId   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model User {
  id             String        @id @default(cuid())
  /** Null for people who signed in with Google only. */
  phone          String?       @unique
  /** Google account id ("sub"); set on the first Google sign-in. */
  googleId       String?       @unique
  email          String?
  name           String?
  role           UserRole      @default(OWNER)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?
  invitations    Invitation[]
  sessions       Session[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

/// One-time SMS login code. Only an HMAC of the code is stored.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// Login session. The cookie holds a random token; only its sha256 is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Template {
  id           String       @id @default(cuid())
  name         String
  type         TemplateType
  /// React component in client/src/templates (one of TEMPLATE_KEYS in @chakyruu/shared).
  componentKey String       @default("classic")
  /// Listed under every toi type filter.
  isUniversal  Boolean      @default(false)
  sortOrder    Int          @default(0)
  previewUrl   String?
  /// Component templates: free-form settings. Illustrated templates: the manifest (shared/src/manifest.ts).
  config       Json         @default("{}")
  /// Publish price of this design in som; null → the INVITATION_PUBLISH price from the Price table.
  priceSom     Int?
  badge        TemplateBadge?
  /// Hidden from the catalog and cannot be picked for new invitations (existing ones keep working).
  isActive     Boolean      @default(true)
  /// Catalog card text: { "ky": "...", "ru": "..." }.
  description  Json         @default("{}")
  invitations  Invitation[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Invitation {
  id                     String            @id @default(cuid())
  slug                   String            @unique
  template               Template          @relation(fields: [templateId], references: [id])
  templateId             String
  owner                  User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId                String
  organization           Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId         String?
  eventType              TemplateType      @default(WEDDING)
  /// Drafts start empty; publishing requires hostNames, eventDate and venueName.
  hostNames              String            @default("")
  eventDate              DateTime?
  venueName              String            @default("")
  venueAddress           String?
  venueMapUrl            String?
  photoUrl               String?
  /// Storage key of the uploaded photo (to delete it when replaced).
  photoKey               String?
  /// A catalogue track; null when there is no music or the owner uploaded their own mp3.
  musicTrack             Track?            @relation(fields: [musicTrackId], references: [id], onDelete: SetNull)
  musicTrackId           String?
  /// Owner's own mp3 (replaces the catalogue track).
  customMusicUrl         String?
  customMusicKey         String?
  customMusicDurationSec Int?
  /// Second the music starts from.
  musicStartSec          Int               @default(0)
  message                String?
  language               Language          @default(KY)
  adultsOnly             Boolean           @default(false)
  /// One of the template's palettes (null = its first).
  paletteId              String?
  /// Big number on the "Юбилей" template (age).
  heroNumber             Int?
  openingAnimation       OpeningAnimation  @default(BOZ_UY)
  /// Toi programme: [{ time: "18:00", title: "Тосуп алуу" }], validated by programSchema.
  program                Json              @default("[]")
  /// "Made with Chakyruu.kg" hidden — allowed only on partner gifts.
  hideBranding           Boolean           @default(false)
  /// Partner branding only — these never grant access to the client's guests.
  venueOrg               Organization?     @relation("VenueInvitations", fields: [venueOrgId], references: [id], onDelete: SetNull)
  venueOrgId             String?
  tamadaOrg              Organization?     @relation("TamadaInvitations", fields: [tamadaOrgId], references: [id], onDelete: SetNull)
  tamadaOrgId            String?
  hall                   Hall?             @relation(fields: [hallId], references: [id], onDelete: SetNull)
  hallId                 String?
  giftCode               GiftCode?
  status                 InvitationStatus  @default(DRAFT)
  publishedAt            DateTime?
  guests                 Guest[]
  tilekter               Tilek[]
  payments               Payment[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  /// Photo strip below the hero (ordered by sortOrder).
  gallery                InvitationPhoto[]

  @@index([ownerId])
  @@index([organizationId])
  @@index([templateId])
  @@index([venueOrgId, eventDate])
  @@index([tamadaOrgId, eventDate])
}

model Guest {
  id           String      @id @default(cuid())
  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  name         String
  phone        String?
  /// Secret for the personal link /:slug?g=<token>.
  token        String      @unique
  status       GuestStatus @default(INVITED)
  /// People coming including the guest (meaningful when ATTENDING).
  guestsCount  Int         @default(1)
  source       GuestSource @default(INVITED)
  respondedAt  DateTime?
  tilekter     Tilek[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([invitationId, status])
  @@index([invitationId, createdAt])
}

enum PaymentPurpose {
  INVITATION
  CREDIT_PACKAGE
}

model Payment {
  id             String          @id @default(cuid())
  purpose        PaymentPurpose  @default(INVITATION)
  /// INVITATION payments.
  invitation     Invitation?     @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId   String?
  /// CREDIT_PACKAGE payments.
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?
  priceCode      String?
  credits        Int?
  /// Amount in tyiyn (1 som = 100 tyiyn) to avoid floating point errors.
  amount         Int
  /// Payment method the client picked (MBank / O!Деньги / Элсом).
  provider       PaymentProvider
  /// Implementation that processed it: fake | manual | mbank | odengi | elsom (PAYMENT_PROVIDER).
  gateway        String          @default("fake")
  status         PaymentStatus   @default(PENDING)
  externalId     String?
  /// Short code for manual transfers ("CH-7K3M") — the payer writes it in the transfer comment.
  reference      String?         @unique
  rawResponse    Json?
  paidAt         DateTime?
  confirmedById  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([gateway, externalId])
  @@index([invitationId])
  @@index([organizationId])
  @@index([status, createdAt])
}

/// Wish (тилек) left by a guest on the invitation page.
model Tilek {
  id           String      @id @default(cuid())
  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  /// Set when written through a personal link.
  guest        Guest?      @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestId      String?
  authorName   String
  text         String
  /// Hidden by the owner: not shown publicly.
  hidden       Boolean     @default(false)
  likesCount   Int         @default(0)
  likes        TilekLike[]
  createdAt    DateTime    @default(now())

  @@index([invitationId, hidden, createdAt])
}

/// One like per browser (anonymous client id kept in localStorage).
model TilekLike {
  tilek     Tilek    @relation(fields: [tilekId], references: [id], onDelete: Cascade)
  tilekId   String
  clientId  String
  createdAt DateTime @default(now())

  @@id([tilekId, clientId])
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
}

/// Partnership request from a тойкана / тамада / agency on the landing page.
model PartnerLead {
  id             String     @id @default(cuid())
  type           OrgType    @default(VENUE)
  status         LeadStatus @default(NEW)
  name           String
  phone          String
  venueName      String
  city           String?
  /// Set when ADMIN created an organization from this lead.
  organizationId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  @@index([status, createdAt])
}

enum PriceAudience {
  CLIENT
  VENUE
  TAMADA
}

/// Prices editable in /admin. AGENCY partners buy VENUE packages.
model Price {
  code      String        @id
  audience  PriceAudience
  amountSom Int
  /// Number of invitation credits in a package (null for single-invitation prices).
  credits   Int?
  active    Boolean       @default(true)
  sortOrder Int           @default(0)
  updatedAt DateTime      @updatedAt
}

enum TrackCategory {
  ULUTTUK
  ZAMANBAP
  BALDARGA
  KLASSIKA
}

/// Music catalogue. Only licence-clean files; the admin enables a track once its file is in place.
model Track {
  id          String        @id @default(cuid())
  title       String
  category    TrackCategory
  /// "/music/x.mp3" (shipped with the client) or a storage URL (uploaded by the admin).
  file        String?
  /// Storage key when the file was uploaded (to delete it when replaced).
  fileKey     String?
  durationSec Int?
  active      Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  invitations Invitation[]

  @@index([active, category, sortOrder])
}

/// Gallery: up to GALLERY_MAX_PHOTOS webp photos shown as a swipeable strip.
model InvitationPhoto {
  id           String     @id @default(cuid())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  url          String
  /// Storage key, to delete the file with the photo.
  key          String
  width        Int
  height       Int
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([invitationId, sortOrder])
}
