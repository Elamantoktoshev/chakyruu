// Chakyruu.kg — data model.
// Multi-tenant ready: Organization (тойкана / агентство) owns users and invitations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgPlan {
  FREE
  PRO
  BUSINESS
}

enum UserRole {
  OWNER
  ORG_ADMIN
  ADMIN
}

enum TemplateType {
  WEDDING
  BESHIK
  SUNNOT
  MAARAKE
}

enum Language {
  KY
  RU
}

enum InvitationStatus {
  DRAFT
  PAID
  PUBLISHED
}

enum PaymentProvider {
  MBANK
  ODENGI
  ELSOM
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  phone       String?
  plan        OrgPlan      @default(FREE)
  users       User[]
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id             String        @id @default(cuid())
  phone          String        @unique
  name           String?
  role           UserRole      @default(OWNER)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?
  invitations    Invitation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model Template {
  id          String       @id @default(cuid())
  name        String
  type        TemplateType
  previewUrl  String?
  config      Json         @default("{}")
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Invitation {
  id             String           @id @default(cuid())
  slug           String           @unique
  template       Template         @relation(fields: [templateId], references: [id])
  templateId     String
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?
  hostNames      String
  eventDate      DateTime
  venueName      String
  venueAddress   String?
  venueMapUrl    String?
  photoUrl       String?
  musicUrl       String?
  message        String?
  language       Language         @default(KY)
  status         InvitationStatus @default(DRAFT)
  rsvps          Rsvp[]
  payments       Payment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([ownerId])
  @@index([organizationId])
  @@index([templateId])
}

model Rsvp {
  id           String     @id @default(cuid())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  guestName    String
  attending    Boolean
  guestsCount  Int        @default(1)
  comment      String?
  createdAt    DateTime   @default(now())

  @@index([invitationId, createdAt])
}

model Payment {
  id           String          @id @default(cuid())
  invitation   Invitation      @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  /// Amount in tyiyn (1 som = 100 tyiyn) to avoid floating point errors.
  amount       Int
  provider     PaymentProvider
  status       PaymentStatus   @default(PENDING)
  externalId   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([invitationId])
}
