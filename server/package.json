{
  "name": "@chakyruu/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.seed.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "seed": "tsx --env-file-if-exists=../.env prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "test:unit": "vitest run --project unit",
    "seed:prod": "node --env-file-if-exists=../.env dist-seed/seed.js",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "release": "npm run migrate:deploy && npm run seed:prod",
    "uploads:to-spaces": "tsx --env-file-if-exists=../.env scripts/migrate-uploads-to-spaces.ts",
    "db:dump": "tsx --env-file-if-exists=../.env scripts/db-dump-to-spaces.ts",
    "brand:render": "tsx scripts/render-brand-assets.ts",
    "sms:test": "tsx --env-file-if-exists=../.env scripts/sms-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@chakyruu/shared": "0.1.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^11.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.4",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
