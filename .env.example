# Postgres (docker-compose.yml читает эти же переменные)
POSTGRES_USER=chakyruu
POSTGRES_PASSWORD=chakyruu
POSTGRES_DB=chakyruu
POSTGRES_PORT=5432

# Prisma / server
DATABASE_URL=postgresql://chakyruu:chakyruu@localhost:5432/chakyruu?schema=public
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Auth: секрет для HMAC одноразовых SMS-кодов (минимум 32 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Сколько reverse-proxy стоит перед API (для корректного IP клиента и rate limit). Локально — 1 (Vite proxy).
TRUST_PROXY=1

# Только для разработки: вход по одному номеру, без SMS-кода. В проде сервер с этим флагом не запустится.
DEV_LOGIN_WITHOUT_SMS=false

# Номер супер-админа: npm run seed выдаёт ему роль ADMIN (формат +996XXXXXXXXX)
ADMIN_PHONE=

# Платежи. PAYMENT_PROVIDER = fake (dev, оплата сразу успешна) | manual (перевод на MBank + подтверждение в /admin)
# | mbank | odengi | elsom (каркасы — пока не реализованы, в проде сервер с ними не стартует).
PAYMENT_PROVIDER=fake
# Публичный адрес сайта для ссылок возврата от платёжки (по умолчанию CORS_ORIGIN).
PUBLIC_APP_URL=
# manual: номер MBank, на который клиенты переводят деньги.
MANUAL_PAYMENT_RECEIVER=
# Ключи мерчанта — названия предварительные, уточнить у провайдера при подписании договора.
MBANK_MERCHANT_ID=
MBANK_SECRET_KEY=
MBANK_API_URL=
ODENGI_MERCHANT_ID=
ODENGI_SECRET_KEY=
ODENGI_API_URL=
ELSOM_MERCHANT_ID=
ELSOM_SECRET_KEY=
ELSOM_API_URL=
