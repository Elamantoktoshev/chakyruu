# Postgres (docker-compose.yml читает эти же переменные)
POSTGRES_USER=chakyruu
POSTGRES_PASSWORD=chakyruu
POSTGRES_DB=chakyruu
POSTGRES_PORT=5432

# Prisma / server
DATABASE_URL=postgresql://chakyruu:chakyruu@localhost:5432/chakyruu?schema=public
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Auth: секрет для HMAC одноразовых SMS-кодов (минимум 32 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Сколько reverse-proxy стоит перед API (для корректного IP клиента и rate limit). Локально — 1 (Vite proxy).
TRUST_PROXY=1
