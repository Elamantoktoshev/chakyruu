# Chakyruu.kg — переменные окружения.
# Локально: скопируйте в .env. В проде (DigitalOcean) они задаются в настройках приложения (см. DEPLOY.md).
# Сервер проверяет их при старте (server/src/config/env.ts) и не запускается, если чего-то
# не хватает: в логе будет список всех проблем сразу.

# ── Postgres для локальной разработки (docker-compose.yml читает эти же переменные) ──────
POSTGRES_USER=chakyruu
POSTGRES_PASSWORD=chakyruu
POSTGRES_DB=chakyruu
POSTGRES_PORT=5432

# ── Сервер ──────────────────────────────────────────────────────────────────────────────
# development | test | production. В production — secure-cookie и строгие проверки ниже.
NODE_ENV=development
DATABASE_URL=postgresql://chakyruu:chakyruu@localhost:5432/chakyruu?schema=public
PORT=4000
# Публичный адрес сайта, без слеша в конце: CORS, ссылки в платежах, превью приглашений, QR-коды.
# В проде только https (в App Platform: ${APP_URL}). Потом просто поменять на https://chakyruu.kg.
CLIENT_URL=http://localhost:5173
# Сколько reverse-proxy стоит перед API (для IP клиента). Локально — 1 (Vite proxy).
TRUST_PROXY=1
# Заголовок с настоящим IP клиента от хостинга. DigitalOcean: do-connecting-ip. Локально — пусто.
CLIENT_IP_HEADER=
# Показывается в GET /api/health (App Platform подставляет сам: ${_self.COMMIT_HASH}).
COMMIT_SHA=

# ── Вход ────────────────────────────────────────────────────────────────────────────────
# Секрет для хеширования SMS-кодов, минимум 32 случайных символа:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
# Только для разработки: вход по одному номеру, без SMS. В проде сервер с этим флагом не запустится.
DEV_LOGIN_WITHOUT_SMS=false
# Демо-номера: вход с фиксированным кодом, SMS не отправляется (показывать продукт клиентам).
#   +996555000001:123456,+996555000002:654321   — номер админа сюда ставить нельзя.
TEST_LOGIN_PHONES=
# Супер-админ: сид выдаёт этому номеру роль ADMIN (формат +996XXXXXXXXX).
ADMIN_PHONE=

# ── SMS ─────────────────────────────────────────────────────────────────────────────────
# console (разработка: код печатается в лог сервера) | nikita (Nikita.kg, обязательно в проде).
SMS_PROVIDER=console
NIKITA_LOGIN=
NIKITA_PASSWORD=
# Имя отправителя, согласованное с Nikita.kg.
NIKITA_SENDER=
# NIKITA_API_URL=https://smspro.nikita.kg/api/message
# Пробный режим Nikita: проверяет логин, отправителя и баланс, но SMS не отправляет и деньги не списывает.
# Для первой проверки ключей локально; в проде сервер с ним не запустится.
NIKITA_TEST_MODE=false
# Максимум SMS со всего сайта за сутки — защита баланса от SMS-бомбинга. Демо-номера не считаются.
SMS_DAILY_LIMIT=500

# ── Хранилище файлов (фото, музыка) ─────────────────────────────────────────────────────
# local (разработка: папка server/uploads) | spaces (DigitalOcean Spaces, обязательно в проде:
# диск контейнера очищается при каждом деплое).
STORAGE_PROVIDER=local
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
# Например fra1
SPACES_REGION=
# Например https://chakyruu.fra1.cdn.digitaloceanspaces.com
SPACES_CDN_URL=

# ── Сжатие mp3 ──────────────────────────────────────────────────────────────────────────
# Необязательно: свой ffmpeg. По умолчанию берётся бинарник из пакета ffmpeg-static.
FFMPEG_PATH=

# ── Наблюдаемость ───────────────────────────────────────────────────────────────────────
# Уровень логов (JSON в проде, читаемые строки локально): fatal | error | warn | info | debug. По умолчанию info.
LOG_LEVEL=
# Telegram-уведомления администратору: оплаты, новые пользователи, заявки, проблемы с SMS.
# Бот создаётся в @BotFather; chat id подскажет `npm run telegram:test` (см. DEPLOY.md, раздел 13).
# Оба пусто — уведомления выключены.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Вход через Google (DEPLOY.md, раздел 16). Оба пусто — кнопки «Google менен кирүү» нет.
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google-аккаунты с правами админа (через запятую). Почту должен подтвердить Google.
ADMIN_EMAILS=
# false — вход только через Google: формы телефона нет, SMS для входа не отправляются. Пусто — телефон включён.
PHONE_LOGIN_ENABLED=

# Sentry (sentry.io) — отчёты об ошибках. Пусто — выключено. SENTRY_DSN_CLIENT — отдельный проект
# для браузера (если пусто, браузер использует SENTRY_DSN).
SENTRY_DSN=
SENTRY_DSN_CLIENT=
# Umami Cloud (umami.is) — аналитика без cookie. Пусто — выключено. ID сайта из настроек Umami.
UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# ── Сид ─────────────────────────────────────────────────────────────────────────────────
# Демо-приглашение и партнёры при разработке (по умолчанию включено). В проде демо не создаётся никогда.
SEED_DEMO=true

# ── Платежи ─────────────────────────────────────────────────────────────────────────────
# fake (dev, оплата сразу успешна) | manual (перевод на MBank + подтверждение в /admin)
# | mbank | odengi | elsom (каркасы, пока не реализованы — в проде сервер с ними не стартует).
PAYMENT_PROVIDER=fake
# Необязательно: адрес для ссылок возврата от платёжки, если отличается от CLIENT_URL.
PUBLIC_APP_URL=
# manual: номер MBank, на который клиенты переводят деньги.
MANUAL_PAYMENT_RECEIVER=
# Номер для переводов через Симбанк; пусто — тот же, что MANUAL_PAYMENT_RECEIVER.
MANUAL_PAYMENT_RECEIVER_SIMBANK=
# Ключи мерчанта — названия предварительные, уточнить у провайдера при подписании договора.
MBANK_MERCHANT_ID=
MBANK_SECRET_KEY=
MBANK_API_URL=
ODENGI_MERCHANT_ID=
ODENGI_SECRET_KEY=
ODENGI_API_URL=
ELSOM_MERCHANT_ID=
ELSOM_SECRET_KEY=
ELSOM_API_URL=
